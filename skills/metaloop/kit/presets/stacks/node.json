{
 "about": "Node.js with npm (Jest by default; Vitest: set the test step's tests to vitest).",
 "requires": [
  {
   "tool": "node",
   "for": "builds and tests",
   "install": "brew install node (macOS) · nodejs.org · nvm",
   "who": "owner",
   "check": "command -v node && command -v npm"
  }
 ],
 "gate": {
  "steps": [
   {
    "name": "install",
    "run": "npm ci"
   },
   {
    "name": "build",
    "run": "npm run build --if-present"
   },
   {
    "name": "lint",
    "run": "npm run lint --if-present"
   },
   {
    "name": "test",
    "run": "npm test",
    "tests": "jest",
    "slots": 3,
    "db": true
   }
  ]
 },
 "verify": {
  "url": "http://localhost:3000",
  "health": "/",
  "build": "npm ci && npm run build --if-present",
  "start": "PORT={app_port} npm start"
 },
 "chain_allow": [
  "npm ci",
  "npm test*",
  "npm run *",
  "npx jest *",
  "npx vitest *",
  "npx tsc *"
 ]
}
