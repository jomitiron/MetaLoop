{
 "about": "Python with a virtualenv in .venv and pytest (requirements.txt, or the project's own install line).",
 "requires": [
  {
   "tool": "python3",
   "for": "builds and tests",
   "install": "brew install python (macOS) · python.org",
   "who": "owner"
  }
 ],
 "gate": {
  "steps": [
   {
    "name": "setup",
    "run": "python3 -m venv .venv && .venv/bin/python -m pip install -q -r requirements.txt"
   },
   {
    "name": "test",
    "run": ".venv/bin/python -m pytest -q -rfE",
    "tests": "pytest",
    "slots": 3,
    "db": true
   }
  ]
 },
 "verify": {
  "url": "http://localhost:8000",
  "health": "/",
  "build": "python3 -m venv .venv && .venv/bin/python -m pip install -q -r requirements.txt",
  "start": "FILL IN: the command that serves the app on {app_port}, e.g. .venv/bin/python manage.py runserver 127.0.0.1:{app_port} or .venv/bin/python -m uvicorn app.main:app --port {app_port}"
 },
 "chain_allow": [
  ".venv/bin/python -m pytest *",
  ".venv/bin/pytest *",
  ".venv/bin/python -m pip install -q -r requirements.txt"
 ]
}
